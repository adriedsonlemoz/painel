# Ambiente local usado pelo Manager/Termux
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://127.0.0.1:5173,http://localhost:5173

# O painel interno pode configurar MongoDB e integrações.
# MONGO_URI=
# CREDENTIALS_MASTER_KEY=gere-uma-chave-com-no-minimo-32-caracteres
# JWT_SECRET=gere-uma-chave-com-no-minimo-32-caracteres
# JWT_CLOUD_EXPIRES_IN=12h  # fallback de sessão Vercel → Render; opcional
# JWT_CLOUD_PERSIST_EXPIRES_IN=7d  # quando “Manter conectado” estiver marcado
REDIS_URL=

MONGO_DB_NAME=alsistemas

# Cloudflare / R2 — normalmente configurado pelo painel e persistido no cofre/MongoDB.
# Estas variáveis continuam aceitas como fallback e fazem parte do backup .env de Integrações.
# CF_API_TOKEN=
# CF_ACCOUNT_ID=
# CF_R2_ACCESS_KEY_ID=
# CF_R2_SECRET_ACCESS_KEY=
# CF_R2_BUCKET=
# CF_R2_PUBLIC_URL=
# CF_R2_ENDPOINT=

# Conteúdo dinâmico do portal — normalmente configurado por Integrações e APIs.
# API_NINJAS_KEY=
# API_NINJAS_TRANSLATE_PT_BR=true
# API_FOOTBALL_KEY=
# IDs de ligas opcionais, separados por vírgula. Também pode ser definido no painel.
# API_FOOTBALL_LEAGUES=
# API_FOOTBALL_MAX_MATCHES=6
# API_FOOTBALL_LIVE_CACHE_SECONDS=300
# API_FOOTBALL_SHOW_INTERNATIONAL=true

# Núcleo de IA — opcionais. As chaves/modelos continuam em Integrações e APIs.
# Tempo máximo de uma tentativa individual contra Gemini/OpenRouter (ms).
AI_TIMEOUT_MS=20000
# Orçamento máximo da operação completa, incluindo retry e fallback (ms).
AI_OPERATION_TIMEOUT_MS=45000
# Número máximo de chamadas simultâneas ao motor de IA.
AI_CONCURRENCY=2
# Quantidade máxima de solicitações aguardando na fila.
AI_MAX_QUEUE=100
# Falhas consecutivas antes de pausar temporariamente um provedor.
AI_CIRCUIT_FAILURES=3
# Cooldown padrão do circuit breaker; Retry-After do provedor tem prioridade (ms).
AI_CIRCUIT_COOLDOWN_MS=60000
# Quando a API indicar cota diária, evita novas tentativas repetidas por 15 min (ms).
AI_DAILY_QUOTA_COOLDOWN_MS=900000

# Atualizador cloud — retomada de publicação GitHub persistida no MongoDB.
AL_UPDATE_PUBLISH_HEARTBEAT_STALE_MS=35000
AL_UPDATE_PUBLISH_MAX_ATTEMPTS=3
AL_UPDATE_GITHUB_PUBLISH_TIMEOUT_MS=1500000

# Em Render/Vercel o AL detecta o proxy automaticamente. Em VPS atrás de
# Nginx/Cloudflare, ative manualmente para IP/rate-limit corretos.
# TRUST_PROXY=1

# Contingência pública do portal — gera automaticamente um snapshot no R2.
# Requer o R2 já configurado e, para acesso público pela Vercel, CF_R2_PUBLIC_URL.
PUBLIC_SNAPSHOT_INTERVAL_MS=300000
PUBLIC_SNAPSHOT_NEWS_LIMIT=250
