# Desenvolvimento local
VITE_API_URL=http://127.0.0.1:3001/api
VITE_APP_NAME=AL Sistemas
VITE_APP_TAGLINE=Painel de Gerenciamento
VITE_APP_VERSION=1.0.152
VITE_APP_ENV=development

# Cache público cache-first: 10 min de frescor, revalidação em segundo plano e
# descarte da cópia local do navegador após 24 h. Valores em milissegundos.
# VITE_PUBLIC_CACHE_TTL_MS=600000
# VITE_PUBLIC_CACHE_MAX_AGE_MS=86400000

# Contingência pública (opcional no navegador; na Vercel prefira NEWS_FALLBACK_URL)
# VITE_NEWS_FALLBACK_URL=https://SEU-DOMINIO-R2/alsistemas/fallback/public-snapshot-v1.json

# Vercel: substitua VITE_API_URL pela URL pública do backend Render + /api
# Ex.: https://seu-backend.onrender.com/api
#
# Funções serverless independentes do Render:
# NEWS_FALLBACK_URL=https://SEU-DOMINIO-R2/alsistemas/fallback/public-snapshot-v1.json
# ou apenas:
# CF_R2_PUBLIC_URL=https://SEU-DOMINIO-R2
#
# Serviços monitorados por /status (opcional; há defaults para API do portal e GuiaDoA):
# STATUS_SERVICES_JSON=[{"id":"portal-api","name":"API do portal","url":"https://al-sistemas-api.onrender.com/api/health/ready","provider":"Render"},{"id":"guiadoa","name":"GuiaDoA","url":"https://guiadoa-agrq.onrender.com/","provider":"Render"}]
# STATUS_TIMEOUT_MS=9000
